# =====================================================================
# SpamGuard AI — Environment Configuration Template
# =====================================================================
# Copy this file to .env and supply your credentials.
# NEVER commit real credentials, OAuth client secrets, or private keys to Git.

# ---------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Gmail API)
# ---------------------------------------------------------------------
# Obtain these from Google Cloud Console > APIs & Services > Credentials
# Create an "OAuth 2.0 Client ID" with Application type "Web application"
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Authorized redirect URI configured in Google Cloud Console
# Must match EXACTLY:
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---------------------------------------------------------------------
# Application Security & Session Signing
# ---------------------------------------------------------------------
# Cryptographic secret used to sign HttpOnly session cookies and state tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SESSION_SECRET=your_cryptographically_secure_random_session_secret_32_chars_min

# ---------------------------------------------------------------------
# Service URLs & Networking
# ---------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
